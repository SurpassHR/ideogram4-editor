# AI Gateway listens on loopback by default. Change only if you understand the
# exposure model; a public gateway should sit behind real authentication.
AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=8787
AI_GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared token. The frontend does not send it yet; use it for curl or
# for a future authenticated frontend integration.
# AI_GATEWAY_TOKEN=replace-with-a-long-random-token

# Built-in provider credentials. Keep these out of the browser bundle.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-5.1,gpt-5.1-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODELS=claude-sonnet-4-6

# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODELS=gemini-3.8-flash

# Local or custom OpenAI-compatible endpoint.
# OPENAI_COMPAT_ID=local-vllm
# OPENAI_COMPAT_NAME=Local vLLM
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_COMPAT_API_KEY=local-secret
# OPENAI_COMPAT_MODELS=qwen3-coder

# Advanced: arbitrary provider list as JSON. Entries override env-built
# providers with the same id. Keep this on one line in .env.
# AI_GATEWAY_PROVIDERS=[{"id":"team","name":"Team Gateway","kind":"openai_compat","baseUrl":"https://llm.example.com/v1","apiKey":"secret","models":["team-model"]}]

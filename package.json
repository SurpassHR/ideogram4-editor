{
  "name": "ideogram4-editor",
  "private": true,
  "version": "0.1.0",
  "main": "out/main/index.js",
  "desktopName": "ideogram4-editor.desktop",
  "description": "Ideogram4 JSON prompt visual editor",
  "author": {
    "name": "SurpassHR",
    "email": "surpasshr@users.noreply.github.com"
  },
  "homepage": "https://gp.hrfuqiang.top/ideogram4-editor/",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "tsc -b && electron-vite build",
    "build:web": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "gateway": "node --env-file-if-exists=.env server/index.ts",
    "gateway:dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dompurify": "^3.4.10",
    "fflate": "^0.8.3",
    "marked": "^18.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.9"
  }
}
